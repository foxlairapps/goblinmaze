    },
    {
      "id": "scene_03_intro",
      "title": "Sráz nad potokem",
      "text": "Těžký povoz uvízl mezi balvany nad rozvodněným potokem."
    },
    {
      "id": "scene_03_poi_03_found",
      "title": "Zaklíněný vůz",
      "text": "Zboží zůstalo nedotčené, ale kočí chybí.",
      "nextTarget": {
        "type": "return"
      }
    },
    {
      "id": "scene_03_success",
      "title": "Pokračování",
      "text": "Najdeš stopy vedoucí k lesnímu průchodu."
    },
    {
      "id": "scene_04_intro",
      "title": "Návrat do vsi",
      "text": "Kočí čeká v lesním úkrytu a nemůže projít zpět."
    },
    {
      "id": "scene_04_poi_04_found",
      "title": "Zraněný kočí",
      "text": "Kočí přizná, že se bál vlků víc než cesty.",
