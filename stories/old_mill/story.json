  "screens": [
    {
      "id": "scene_01_intro",
      "title": "Mlýn bez mouky",
      "text": "Mlynář ukazuje rozházené pytle. Stopy vedou do staré násypky."
    },
    {
      "id": "scene_01_poi_01_found",
      "title": "Roztržený pytel",
      "text": "Mezi zrním jsou otisky drobných drápů.",
      "nextTarget": {
        "type": "return"
      }
    },
    {
      "id": "scene_01_success",
      "title": "Pokračování",
      "text": "V otvoru mezi prkny mizí celé hrsti obilí."
    },
    {
      "id": "scene_02_intro",
      "title": "Ve vlhkém sklepě",
      "text": "Ze sklepa táhne chlad; pod policemi se cosi hýbe."
    },
    {
      "id": "scene_02_poi_02_found",
      "title": "Mlynářův zápisník",
      "text": "Někdo zapisoval dodávky krmení do sklepů.",
      "nextTarget": {
        "type": "return"
      }
    },
    {
      "id": "scene_02_success",
      "title": "Pokračování",
      "text": "Krysy sem někdo láká záměrně."
    },
    {
      "id": "scene_03_intro",
      "title": "Hnízdo pod základy",
      "text": "Pod mlýnem se rozprostírá staré zdivo a chodbičky."
    },
    {
      "id": "scene_03_poi_03_found",
      "title": "Královna krys",
      "text": "V hnízdě leží ukradená pečeť i mlynářovo nářadí.",
      "nextTarget": {
        "type": "return"
      }
    },
    {
      "id": "scene_03_success",
      "title": "Pokračování",
      "text": "Hnízdo je zničeno, ale původ pečeti zůstává záhadou."
    },
    {
      "id": "scene_04_intro",
      "title": "Poslední pytel",
      "text": "Nad mlýnem svítá a mlynář chce zachránit zbylé obilí."
    },
    {
      "id": "scene_04_poi_04_found",
      "title": "Zachráněné obilí",
      "text": "Mlynář může znovu spustit mlýnské kameny.",
      "nextTarget": {
        "type": "return"
      }
    },
    {
      "id": "scene_04_success",
      "title": "Pokračování",
      "text": "Získáváš odměnu a místo u večerního stolu."
    },
    {
      "id": "story_intro",
      "title": "Krysy ve starém mlýně",
      "text": "Mlynářovi mizí zásoby. Pod podlahou se ale skrývá něco víc než obyčejné krysy. Přijímáš zakázku a vyrážíš zjistit, co se skutečně stalo.",
      "nextTarget": {
        "type": "scene",
        "id": "scene_01"
      }
    },
    {
      "id": "ending_success",
      "title": "Mistrovské dokončení",
      "text": "Krysy ve starém mlýně: úkol jsi dokončil s mimořádným výsledkem. Tvůj čin se bude dlouho vyprávět."
    },
    {
      "id": "ending_success_2",
      "title": "Zakázka splněna",
      "text": "Krysy ve starém mlýně: všechny zásadní kroky jsou za tebou. Získáváš odměnu a místo u večerního stolu."
    },
    {
      "id": "ending_fail",
      "title": "Nedokončená zakázka",
      "text": "Cesta se pro tuto chvíli uzavřela. Vrátíš se lépe připravený."
    }
